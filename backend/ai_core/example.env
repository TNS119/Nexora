# Nexora AI & Signal Processing - Environment Variables

# Your Groq API key for transcription and LLM intent analysis
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# (Optional) The Groq transcription model to use. 
# Default: whisper-large-v3
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# (Optional) The Groq chat model to use for coercion intent analysis.
# Default: llama-3.1-8b-instant
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
